# IDE 
.idea/

# Database and data directories
idp_mysql_data/
postgresql/
rabbitmq/

# Environment files with secrets
.env

# Data directories - parquet files (temporary storage)
move-writer-data/

# MinIO object storage (don't commit)
minio-data/

# MLflow tracking
mlflow-data/
mlruns/

# DVC cache (optional - can be shared or local)
.dvc/cache/
.dvc/tmp/

# Datasets - Ignore actual data files, keep DVC metadata
datasets/*.parquet
datasets/*.csv
# DON'T ignore: datasets/*.dvc (DVC metadata)
# DON'T ignore: datasets/.gitignore (DVC auto-generated)
